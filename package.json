{
  "name": "harmony-logger-tooling",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "generate:core": "node scripts/sync-core.cjs",
    "check:core": "node scripts/sync-core.cjs --check",
    "test": "node --test tests/*.test.cjs",
    "test:source-core": "node scripts/test-source-core.cjs",
    "build:har": "devecocli build --modules library --build-mode release",
    "build:example": "devecocli build --modules example --build-mode debug"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
